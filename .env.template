# Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env with real credentials to version control

# External API Key for authentication
EXTERNAL_API_KEY="your_actual_api_key_here"

# Database credentials
DB_USER="your_database_user_here"
DB_PASS="your_database_password_here"

# Service authentication token
SERVICE_TOKEN="your_service_token_here"

# RSA Private Key for encryption
# Can be multi-line - use \n for line breaks or paste the entire key
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIICXAIBAAKBgQDN4K...\n-----END RSA PRIVATE KEY-----"
